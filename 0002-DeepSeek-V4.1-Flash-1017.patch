diff --git a/engine/src/b70-deepseek-ops.h b/engine/src/b70-deepseek-ops.h
new file mode 100644
--- /dev/null
+++ b/engine/src/b70-deepseek-ops.h
@@ -0,0 +1,35 @@
+#pragma once
+#include "ggml.h"
+#include <cmath>
+#include <stdexcept>
+
+// DeepSeek reference clamps the raw gate BEFORE SiLU. All operations below
+// execute on the admitted B70; this header contains graph construction only.
+inline ggml_tensor * b70_deepseek_swiglu_clamp(ggml_context * ctx,ggml_tensor * gate,ggml_tensor * up,float limit) {
+    if(!gate||!up||gate->type!=GGML_TYPE_F32||up->type!=GGML_TYPE_F32||
+       !ggml_are_same_shape(gate,up)||!ggml_is_contiguous(gate)||!ggml_is_contiguous(up)||
+       !std::isfinite(limit)||limit<=1e-6f||ggml_nelements(gate)<=0||ggml_nelements(gate)>2304LL*6*32)
+        throw std::runtime_error("Unadmitted B70 DeepSeek clipped activation geometry");
+    auto * clipped_gate=ggml_clamp(ctx,gate,-INFINITY,limit);
+    auto * clipped_up=ggml_clamp(ctx,up,-limit,limit);
+    return ggml_mul(ctx,ggml_silu(ctx,clipped_gate),clipped_up);
+}
+
+inline ggml_tensor * b70_deepseek_row_mask(ggml_context * ctx,ggml_tensor * counts,int64_t width,int64_t streams) {
+    if(!counts||counts->type!=GGML_TYPE_I32||!ggml_is_vector(counts)||!ggml_is_contiguous(counts)||
+       width<=0||width>4096||streams<=0||streams>32||counts->ne[0]<=0||counts->ne[0]>32||counts->ne[0]%streams)
+        throw std::runtime_error("Unadmitted B70 DeepSeek row mask geometry");
+    const int64_t rows=counts->ne[0];
+    auto * columns=ggml_repeat_4d(ctx,ggml_arange(ctx,0.f,float(width),1.f),width,rows,1,1);
+    auto * visible=ggml_reshape_2d(ctx,ggml_cast(ctx,counts,GGML_TYPE_F32),1,rows);
+    // The retained Vulkan STEP shader uses x >= 0: equality is MASKED.
+    // Every column and relevant boundary count is exactly representable in F32.
+    auto * blocked=ggml_step(ctx,ggml_sub(ctx,columns,visible));
+    auto * ids=ggml_reshape_1d(ctx,ggml_cast(ctx,blocked,GGML_TYPE_I32),width*rows);
+    auto * zero=ggml_fill(ctx,ggml_new_tensor_2d(ctx,GGML_TYPE_F32,1,1),0.f);
+    auto * negative_infinity=ggml_fill(ctx,ggml_new_tensor_2d(ctx,GGML_TYPE_F32,1,1),-INFINITY);
+    auto * table=ggml_concat(ctx,zero,negative_infinity,1);
+    // Exact lookup preserves +0/-infinity without log(0), division by zero,
+    // or multiplication of zero by infinity.
+    return ggml_reshape_4d(ctx,ggml_get_rows(ctx,table,ids),width,rows/streams,1,streams);
+}
diff --git a/engine/src/b70-deepseek-tail-rope.h b/engine/src/b70-deepseek-tail-rope.h
new file mode 100644
--- /dev/null
+++ b/engine/src/b70-deepseek-tail-rope.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "ggml.h"
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+
+// Graph construction only. Copies, rotation and concatenation execute on B70.
+// The retained Vulkan shader has no n_offs push constant, so rotate a compact
+// tail with offset zero, preserving every other RoPE parameter byte for byte.
+inline ggml_tensor * b70_deepseek_set_rope_offset(
+        ggml_context * ctx, ggml_tensor * rope, int offset, bool enabled) {
+    if (!enabled || offset == 0) return ggml_rope_set_offset(rope, offset);
+    if (!rope || (rope->op != GGML_OP_ROPE && rope->op != GGML_OP_ROPE_BACK) ||
+            !rope->src[0] || !rope->src[1] || rope->src[3] || offset < 0)
+        throw std::runtime_error("Unadmitted B70 tail RoPE operation");
+    const int32_t dims=rope->op_params[1],mode=rope->op_params[2];
+    auto * input=rope->src[0];
+    if (input->type!=GGML_TYPE_F32 || input->nb[0]!=sizeof(float) ||
+            mode!=GGML_ROPE_TYPE_NORMAL || dims!=64 ||
+            (input->ne[0]!=128 && input->ne[0]!=512) || input->ne[0]!=offset+dims ||
+            input->ne[1]<1 || input->ne[1]>128 || input->ne[2]<1 || input->ne[2]>32 || input->ne[3]!=1 ||
+            ggml_nbytes(input)>(8ULL<<20))
+        throw std::runtime_error("Unadmitted B70 tail RoPE geometry");
+    auto * prefix=ggml_cont(ctx,ggml_view_3d(ctx,input,offset,input->ne[1],input->ne[2],
+            input->nb[1],input->nb[2],0));
+    auto * tail=ggml_cont(ctx,ggml_view_3d(ctx,input,dims,input->ne[1],input->ne[2],
+            input->nb[1],input->nb[2],size_t(offset)*input->nb[0]));
+    auto * rotated=rope->op==GGML_OP_ROPE
+        ? ggml_rope_ext(ctx,tail,rope->src[1],rope->src[2],dims,mode,0,10000.f,1.f,0.f,1.f,0.f,0.f)
+        : ggml_rope_ext_back(ctx,tail,rope->src[1],rope->src[2],dims,mode,0,10000.f,1.f,0.f,1.f,0.f,0.f);
+    std::memcpy(rotated->op_params,rope->op_params,sizeof(rotated->op_params));
+    ggml_rope_set_offset(rotated,0);
+    return ggml_concat(ctx,prefix,rotated,0);
+}
diff --git a/engine/src/b70-sparse-rows.h b/engine/src/b70-sparse-rows.h
new file mode 100644
--- /dev/null
+++ b/engine/src/b70-sparse-rows.h
@@ -0,0 +1,91 @@
+// Private B70 sparse-source transport. This copies encoded bytes only; GET_ROWS
+// and every dequantization/projection remain on the selected GPU.
+#pragma once
+#include "ggml.h"
+#include "ggml-ssd/platform/file.h"
+#include <cstdint>
+#include <climits>
+#include <limits>
+#include <mutex>
+#include <stdexcept>
+#include <vector>
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <io.h>
+#endif
+
+struct llama_b70_sparse_rows {
+    struct fd_owner {
+        int value = -1;
+        ~fd_owner() { if (value >= 0) { ssd::platform::close_fd(value); } }
+        fd_owner() = default;
+        fd_owner(const fd_owner &) = delete;
+    } fd;
+    const ggml_tensor * tensor;
+    const ssd::platform::file_identity version;
+    const uint64_t offset;
+    const size_t stride, bytes;
+    mutable std::mutex mutex;
+
+    llama_b70_sparse_rows(const ggml_tensor * source, int source_fd,
+                         const ssd::platform::file_identity & identity,
+                         uint64_t file_offset) :
+        tensor(source), version(identity), offset(file_offset),
+        stride(source ? source->nb[1] : 0), bytes(source ? ggml_nbytes(source) : 0) {
+        if (source_fd < 0 || !source || source->ne[0] <= 0 || source->ne[1] <= 0 || source->ne[1] > INT32_MAX ||
+                source->ne[2] != 1 || source->ne[3] != 1 || !ggml_is_contiguous(source) ||
+                (source->type != GGML_TYPE_Q8_0 && source->type != GGML_TYPE_BF16) ||
+                !stride || stride > (1u << 20) || uint64_t(source->ne[1]) > UINT64_MAX/stride ||
+                uint64_t(source->ne[1])*stride != bytes || offset > version.size || bytes > version.size-offset) {
+            throw std::runtime_error("B70 sparse source has unadmitted geometry/type/range");
+        }
+#if defined(_WIN32)
+        fd.value = _dup(source_fd);
+        if (fd.value >= 0 && !SetHandleInformation(
+                static_cast<HANDLE>(ssd::platform::native_handle(fd.value)), HANDLE_FLAG_INHERIT, 0)) {
+            throw std::runtime_error("Cannot make sparse source handle non-inheritable");
+        }
+#else
+        (void) source_fd;
+        throw std::runtime_error("B70 sparse transport requires Windows");
+#endif
+        ssd::platform::file_identity now;
+        if (fd.value < 0 || !ssd::platform::identity(fd.value, now) || now != version) {
+            throw std::runtime_error("B70 sparse source retained-handle identity differs");
+        }
+    }
+    llama_b70_sparse_rows(const llama_b70_sparse_rows &) = delete;
+
+    void read(const int32_t * indices, size_t count, std::vector<unsigned char> & output) const {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!indices || count == 0 || count > 2048 || count > (1u << 20)/stride) {
+            throw std::runtime_error("B70 sparse request exceeds its one-MiB transport bound");
+        }
+        ssd::platform::file_identity now;
+        if (!ssd::platform::identity(fd.value, now) || now != version) {
+            throw std::runtime_error("B70 sparse source changed before row gather");
+        }
+        output.resize(count*stride);
+        for (size_t i = 0; i < count; ++i) {
+            const int32_t row = indices[i];
+            if (row < 0 || int64_t(row) >= tensor->ne[1] || uint64_t(row) > UINT64_MAX/stride ||
+                    uint64_t(row)*stride > bytes-stride) {
+                throw std::runtime_error("B70 sparse row index is outside the native table");
+            }
+            const uint64_t at = offset + uint64_t(row)*stride;
+            if (at < offset || at > version.size || stride > version.size-at ||
+                    !ssd::platform::pread_exact(fd.value, output.data()+i*stride, stride, at)) {
+                throw std::runtime_error("B70 sparse row read failed; no retry/fallback");
+            }
+        }
+        if (!ssd::platform::identity(fd.value, now) || now != version) {
+            throw std::runtime_error("B70 sparse source changed during row gather");
+        }
+    }
+};
