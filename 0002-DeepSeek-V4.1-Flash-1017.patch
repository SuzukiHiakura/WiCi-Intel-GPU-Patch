+// Private sparse token-table input: raw bytes are transported on the host;
+// BF16 decoding and all embedding arithmetic run in GPU GET_ROWS.
+class llm_graph_input_b70_sparse_embd final : public llm_graph_input_i {
+public:
+    const llama_model & model;
+    const ggml_tensor * source;
+    ggml_tensor * packed = nullptr;
+    ggml_tensor * rows = nullptr;
+    ggml_tensor * original_tokens = nullptr;
+    std::vector<unsigned char> encoded;
+    std::vector<int32_t> compact;
+    llm_graph_input_b70_sparse_embd(const llama_model & m, const ggml_tensor * t) : model(m), source(t) {}
+    void set_input(const llama_ubatch * batch) override {
+        if (!batch->token || batch->n_tokens != rows->ne[0] || packed->ne[1] != batch->n_tokens) {
+            throw std::runtime_error("B70 sparse token batch shape changed");
+        }
+        model.read_b70_sparse_rows(source, batch->token, batch->n_tokens, encoded);
+        if (encoded.size() != ggml_nbytes(packed)) { throw std::runtime_error("B70 sparse token bytes differ"); }
+        compact.resize(batch->n_tokens);
+        for (size_t i = 0; i < compact.size(); ++i) { compact[i] = int32_t(i); }
+        ggml_backend_tensor_set(packed, encoded.data(), 0, encoded.size());
+        ggml_backend_tensor_set(rows, compact.data(), 0, compact.size()*sizeof(int32_t));
+        ggml_backend_tensor_set(original_tokens, batch->token, 0, compact.size()*sizeof(int32_t));
+    }
+    bool can_reuse(const llm_graph_params & p) override {
+        return p.ubatch.token && p.ubatch.n_tokens == rows->ne[0] && packed->ne[1] == p.ubatch.n_tokens;
+    }
+};
