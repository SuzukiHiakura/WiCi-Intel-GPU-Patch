+        auto * flat = ggml_reshape_2d(ctx0, weight, weight->ne[0], rows);
+        auto * ids = ggml_cast(ctx0, ggml_arange(ctx0, 0.0f, float(rows), 1.0f), GGML_TYPE_I32);
+        auto * f32 = ggml_get_rows(ctx0, flat, ids);
+        effective = ggml_reshape_4d(ctx0, f32, weight->ne[0], weight->ne[1], weight->ne[2], weight->ne[3]);
+    }
+    return ggml_mul_mat(ctx0, effective, input);
+}
