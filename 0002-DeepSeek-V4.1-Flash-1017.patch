+            weight->type == GGML_TYPE_BF16 && input->type == GGML_TYPE_F32 && input->ne[1] > 1) {
+        // Exact BF16->F32 conversion on the GPU, preserving all F32 activations.
+        const int64_t rows = ggml_nrows(weight);
