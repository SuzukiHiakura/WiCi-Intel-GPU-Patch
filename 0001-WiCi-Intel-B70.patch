+namespace {
+constexpr int columns=2048,rows=1024,experts=20;
+constexpr size_t stride=size_t(columns)*rows*sizeof(float),mib=1024*1024;
+void require(bool x,const char * why){if(!x)throw std::runtime_error(why);}
+float weight(int expert,int row,int col){return float((expert*37+row*3+col*13)%31-15)/256.0f;}
+struct source {
+    int fd=-1;
+    ssd::platform::file_identity fixture;
+    const ggml_tensor * metadata=nullptr;
+    static bool validate(void * opaque,const ggml_tensor * t,int descriptor,uint64_t offset,size_t bytes,int64_t count,int expert)noexcept{
+        if(!opaque||!t||expert<0||expert>=experts||bytes!=stride||count!=experts||offset!=uint64_t(expert)*stride)return false;
+        const auto & self=*static_cast<source *>(opaque);ssd::platform::file_identity now;
+        return t==self.metadata&&descriptor==self.fd&&ssd::platform::identity(descriptor,now)&&now==self.fixture;
+    }
+    static bool resolve(void * opaque,const char * name,int expert,size_t bytes,int64_t count,
+                        int * fd,uint64_t * offset,size_t * logical)noexcept{
+        if(!opaque||!name||std::strcmp(name,"probe_experts")!=0||expert<0||expert>=experts||bytes!=stride||count!=experts)return false;
+        *fd=static_cast<source *>(opaque)->fd;*offset=uint64_t(expert)*stride;*logical=stride;return true;
+    }
+};
+struct resources {
+    ggml_context * host_ctx=nullptr,*gpu_ctx=nullptr;
+    ggml_backend_t backend=nullptr;
+    ggml_backend_buffer_t host_buf=nullptr,gpu_buf=nullptr;
+    int fd=-1;
+    ~resources(){
+        if(backend)ggml_backend_synchronize(backend);
+        if(gpu_buf)ggml_backend_buffer_free(gpu_buf);
+        if(host_buf)ggml_backend_buffer_free(host_buf);
+        if(gpu_ctx)ggml_free(gpu_ctx);
+        if(host_ctx)ggml_free(host_ctx);
+        if(fd>=0)ssd::platform::close_fd(fd);
+        if(backend)ggml_backend_free(backend);
+    }
+};
+}
+int main(int argc,char ** argv){
