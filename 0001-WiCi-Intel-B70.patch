+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <memory>
+#include <string>
+namespace ssd { namespace stream {
+// Read-only WDDM accounting for this process on the uniquely selected B70.
+// Never changes reservations, driver state, or another process.
+class memory_guard {
+public:
+    memory_guard(uint64_t local_limit,uint64_t headroom,uint64_t nonlocal_limit);
+    ~memory_guard();
+    memory_guard(const memory_guard &)=delete;
+    memory_guard & operator=(const memory_guard &)=delete;
+    void check(uint64_t planned_local_allocation=0);
+    std::string stats_json() const;
+private:
+    struct impl;
+    std::unique_ptr<impl> state_;
+};
+}}
