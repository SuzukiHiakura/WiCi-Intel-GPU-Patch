+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "ggml-backend.h"
+#include "store/source.h"
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace ssd { namespace stream {
+// Same-build, Windows10/B70-only expert byte transport. Model math stays in
+// the ordinary architecture graph. A configured failure never uses mmap/CPU.
+class buffer_cache {
+public:
+    struct counters {
+        uint64_t ssd_reads=0,ssd_bytes=0,host_hits=0,host_misses=0,host_evictions=0;
+        uint64_t gpu_hits=0,gpu_misses=0,gpu_evictions=0,h2d_bytes=0,d2d_bytes=0,slices=0;
+        uint64_t host_live=0,host_peak=0,gpu_live=0,gpu_peak=0,gpu_reserved=0,gpu_reserved_peak=0,cancellations=0;
+        uint64_t gpu_allocation_bytes=0,gpu_allocation_peak=0,device_local_checks=0,last_destination_allocation_bytes=0;
+    };
+    buffer_cache(store::source_view source,uint64_t host_budget,uint64_t gpu_budget,
+                 uint64_t process_vram_limit=24ULL<<30,uint64_t headroom=1ULL<<30,uint64_t nonlocal_limit=1ULL<<30);
+    ~buffer_cache();
+    buffer_cache(const buffer_cache &)=delete;
+    buffer_cache & operator=(const buffer_cache &)=delete;
+    using source_validator = bool (*)(void *,const ggml_tensor *,int,uint64_t,size_t,int64_t,int) noexcept;
+    void bind_source(source_validator validator,void * userdata);
+    void attach(ggml_backend_t backend);
+    bool prepare_graph(ggml_backend_sched_t scheduler,ggml_cgraph * graph) noexcept;
+    // One owner/context and backend. Each copy finishes its borrowed buffers.
+    int copy(ggml_backend_t backend,const ggml_tensor * source,ggml_tensor * destination,
+             int64_t experts,size_t stride,const int32_t * counts) noexcept;
+    void set_stop(bool (*requested)(void *),void * userdata) noexcept;
+    bool validate_graph(ggml_backend_sched_t scheduler,ggml_cgraph * graph) noexcept;
+    bool observe_memory() noexcept;
+    void invalidate() noexcept;
+    counters stats() const;
+    std::string stats_json() const;
+private:
+    struct impl;
+    std::unique_ptr<impl> state_;
