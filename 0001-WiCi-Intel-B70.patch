+
+namespace ssd { namespace stream {
+namespace {
+constexpr uint64_t mib=uint64_t{1}<<20;
+constexpr size_t alignment=4096,max_read=64*size_t(mib),max_entries=4096;
+using clock=std::chrono::steady_clock;
+size_t aligned_size(size_t n) {
+    if(n>SIZE_MAX-(alignment-1))throw std::runtime_error("expert size overflow");
+    return (n+alignment-1)&~(alignment-1);
+}
+void require(bool ok,const char * why){if(!ok)throw std::runtime_error(why);}
+struct meta_owner {
+    ggml_context * value=nullptr;
+    explicit meta_owner(size_t tensors=4) {
+        value=ggml_init({ggml_tensor_overhead()*tensors,nullptr,true});
+        require(value!=nullptr,"cache tensor metadata allocation failed");
+    }
+    ~meta_owner(){if(value)ggml_free(value);}
+    meta_owner(const meta_owner &)=delete;
+};
+// Include the actual file version, offset and copied bytes; a tensor name or
+// layer/expert index alone is not a payload identity.
+using key=std::tuple<uint64_t,uint64_t,uint64_t,uint64_t,int64_t,int64_t,uint64_t,size_t>;
+key make_key(const platform::file_identity & f,uint64_t offset,size_t bytes){
+    return {f.device,f.id_lo,f.id_hi,f.size,f.mtime_ns,f.ctime_ns,offset,bytes};
+}
+struct host_entry {
+    void * arena=nullptr;
+    size_t allocated=0,lead=0;
+    std::list<key>::iterator lru;
+    ~host_entry(){if(arena)platform::arena_release(arena,allocated);}
+};
+struct gpu_entry {
+    meta_owner meta;
+    ggml_tensor * raw=nullptr;
+    size_t allocated=0,chunk=0,offset=0;
+    std::list<key>::iterator lru;
+};
+struct gpu_chunk {
+    ggml_backend_buffer_t buffer=nullptr;
+    size_t bytes=0;
+    uint64_t allocation_bytes=0;
+    std::map<size_t,size_t> free;
+    ~gpu_chunk(){if(buffer)ggml_backend_buffer_free(buffer);}
+};
+struct read_custody {
+    io::win_ring & ring;
+    ~read_custody(){
+        if(ring.pending()){
+            std::fputs("[b70.cache] failed read still owns a kernel buffer; aborting before release\n",stderr);
+            std::abort();
+        }
+    }
+};
+}
+
+struct buffer_cache::impl {
+    store::source_view source;
+    const uint64_t host_budget,gpu_budget;
+    const uint64_t process_limit,headroom,nonlocal_limit;
+    ggml_backend_t backend=nullptr;
+    ggml_backend_dev_t device=nullptr;
+    ggml_backend_vk_buffer_memory_query_v1 memory_query=nullptr;
+    ggml_backend_vk_alloc_bounded_v1 bounded_alloc=nullptr;
+    io::win_ring ring;
+    counters count;
+    std::map<int,platform::file_identity> file_versions;
+    std::map<key,std::unique_ptr<host_entry>> host;
+    std::map<key,std::unique_ptr<gpu_entry>> gpu;
+    std::vector<std::unique_ptr<gpu_chunk>> chunks;
+    std::unique_ptr<memory_guard> memory;
+    std::list<key> host_lru,gpu_lru;
+    mutable std::mutex mutex;
+    bool (*stop)(void *)=nullptr;
+    void * stop_data=nullptr;
+    uint64_t tag=0;
+    bool failed=false;
+    source_validator validator=nullptr;
+    void * validator_data=nullptr;
+
+    impl(store::source_view s,uint64_t h,uint64_t g,uint64_t limit,uint64_t spare,uint64_t shared):
+        source(s),host_budget(h),gpu_budget(g),process_limit(limit),headroom(spare),nonlocal_limit(shared) {
+        require(source.resolve!=nullptr,"expert source resolver required");
+        require(h>=mib && h<=8*1024*mib && g>=64*mib && g<=16*1024*mib && g%(64*mib)==0,"cache budget outside admission range or 64MiB arena quantum");
+        auto r=ring.init(1,false);require(bool(r),"Windows read ring initialization failed");
+        require(std::strcmp(ring.backend_name(),"overlapped")==0,"Windows10 overlapped backend required");
+    }
+    ~impl(){
+        // Destruction occurs before the borrowed backend/source descriptors.
+        if(backend)ggml_backend_synchronize(backend);
+        gpu.clear();chunks.clear();host.clear();ring.close_ring();
+    }
+    void evict_host(){
+        require(!host_lru.empty(),"host cache cannot satisfy its budget");
+        const key victim=host_lru.back();auto it=host.find(victim);
+        require(it!=host.end(),"host cache LRU invariant");
+        count.host_live-=it->second->allocated;host.erase(it);host_lru.pop_back();++count.host_evictions;
+    }
+    void evict_gpu(){
+        require(!gpu_lru.empty(),"GPU cache cannot satisfy its budget");
+        const key victim=gpu_lru.back();auto it=gpu.find(victim);
+        require(it!=gpu.end(),"GPU cache LRU invariant");
+        // No entry is borrowed across a synchronous copy/scheduler fence.
+        ggml_backend_synchronize(backend);
+        const auto & entry=*it->second;
+        auto & spans=chunks.at(entry.chunk)->free;
+        size_t begin=entry.offset,bytes=entry.allocated;
+        auto after=spans.lower_bound(begin);
+        if(after!=spans.end()&&begin+bytes==after->first){bytes+=after->second;after=spans.erase(after);}
+        if(after!=spans.begin()){
+            auto before=std::prev(after);
+            if(before->first+before->second==begin){begin=before->first;bytes+=before->second;spans.erase(before);}
+        }
+        spans.emplace(begin,bytes);
+        count.gpu_live-=entry.allocated;gpu.erase(it);gpu_lru.pop_back();++count.gpu_evictions;
+    }
+    std::pair<size_t,size_t> slot(size_t needed){
+        constexpr size_t quantum=64*size_t(mib);
+        require(needed<=quantum,"one GPU expert exceeds a bounded cache arena");
+        for(;;){
+            for(size_t i=0;i<chunks.size();++i){
+                auto & spans=chunks[i]->free;
+                for(auto it=spans.begin();it!=spans.end();++it){
+                    if(it->second<needed)continue;
+                    const size_t offset=it->first,remainder=it->second-needed;
+                    spans.erase(it);if(remainder)spans.emplace(offset+needed,remainder);
+                    return {i,offset};
+                }
+            }
+            if(count.gpu_reserved+quantum<=gpu_budget){
+                require(memory!=nullptr,"WDDM memory accounting missing");memory->check(quantum);
+                auto arena=std::make_unique<gpu_chunk>();
+                require(count.gpu_allocation_bytes<gpu_budget,"B70 physical cache allowance exhausted");
+                require(bounded_alloc!=nullptr,"B70 bounded allocation interface missing");
+                arena->buffer=bounded_alloc(backend,quantum,gpu_budget-count.gpu_allocation_bytes);
+                require(arena->buffer!=nullptr,"bounded B70 cache arena allocation failed");
+                arena->bytes=ggml_backend_buffer_get_size(arena->buffer);
+                require(arena->bytes==quantum,"B70 cache arena allocation differs from reserved bytes");
+                ggml_backend_vk_buffer_memory_info_v1 info{};info.version=1;info.size=sizeof(info);
+                require(memory_query&&memory_query(arena->buffer,&info)&&info.strict_device_memory&&info.device_local&&!info.imported_host,
+                        "B70 arena lacks proved strict device-local Vulkan allocation");
+                require(info.buffer_bytes==arena->bytes&&info.allocation_bytes>=arena->bytes&&
+                        info.allocation_bytes<=gpu_budget-count.gpu_allocation_bytes,"B70 physical arena allocation exceeds budget");
+                arena->allocation_bytes=info.allocation_bytes;++count.device_local_checks;
+                ggml_backend_buffer_set_usage(arena->buffer,GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+                arena->free.emplace(0,arena->bytes);
+                count.gpu_reserved+=arena->bytes;count.gpu_reserved_peak=std::max(count.gpu_reserved_peak,count.gpu_reserved);
+                count.gpu_allocation_bytes+=arena->allocation_bytes;
+                count.gpu_allocation_peak=std::max(count.gpu_allocation_peak,count.gpu_allocation_bytes);
+                chunks.push_back(std::move(arena));memory->check();
+            }else{
+                evict_gpu();
+            }
+        }
+    }
+    platform::file_identity version(int fd){
+        platform::file_identity now;
+        require(platform::is_direct(fd)&&platform::identity(fd,now),"expert source is not a direct regular file");
+        const auto prior=file_versions.find(fd);
+        if(prior==file_versions.end()){
+            require(file_versions.size()<1024,"expert source count exceeds qualification bound");
+            file_versions.emplace(fd,now);
+        }
+        else require(prior->second==now,"expert source changed; no retry or invalidation fallback");
+        return now;
+    }
+    bool stopping()const{return stop&&stop(stop_data);}
+    host_entry & read(const key & k,int fd,uint64_t offset,size_t bytes,const platform::file_identity & id){
+        const auto hit=host.find(k);
+        if(hit!=host.end()){
