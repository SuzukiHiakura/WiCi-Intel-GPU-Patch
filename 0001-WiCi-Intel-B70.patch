+        require(!std::filesystem::exists(root),"test directory already exists; no overwrite or retry");
+        std::filesystem::create_directory(root);
+        const auto path=root/"immutable-experts.f32";
+        {
+            std::ofstream file(path,std::ios::binary|std::ios::out);
+            require(bool(file),"cannot create owned fixture");
+            std::vector<float> matrix(size_t(columns)*rows);
+            for(int e=0;e<experts;++e){
+                for(int r=0;r<rows;++r)for(int c=0;c<columns;++c)matrix[size_t(r)*columns+c]=weight(e,r,c);
