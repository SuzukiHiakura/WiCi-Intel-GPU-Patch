+// SPDX-License-Identifier: Apache-2.0
+#include "memory-guard.h"
+#if !defined(_WIN32)
+#error "This WDDM guard is Windows-only"
+#endif
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <dxgi1_4.h>
+#include <wrl/client.h>
+#include <algorithm>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+
+namespace ssd { namespace stream {
+using Microsoft::WRL::ComPtr;
+namespace {
+void success(HRESULT result,const char * name){
+    if(FAILED(result))throw std::runtime_error(std::string(name)+" failed: "+std::to_string(uint32_t(result)));
+}
+uint64_t ticks(const FILETIME & value){return (uint64_t(value.dwHighDateTime)<<32)|value.dwLowDateTime;}
+}
+struct memory_guard::impl {
+    ComPtr<IDXGIAdapter3> adapter;
+    DXGI_ADAPTER_DESC1 desc={};
+    const uint64_t local_limit,headroom,nonlocal_limit;
+    DXGI_QUERY_VIDEO_MEMORY_INFO local={},nonlocal={};
+    uint64_t peak_local=0,peak_nonlocal=0,queries=0,creation=0;
+    DWORD pid=0;
+    mutable std::mutex mutex;
+    impl(uint64_t limit,uint64_t spare,uint64_t shared):local_limit(limit),headroom(spare),nonlocal_limit(shared){
+        constexpr uint64_t mib=1ULL<<20;
+        if(limit<1024*mib||limit>28*1024*mib||spare<128*mib||spare>8192*mib||shared>2048*mib)
+            throw std::runtime_error("WDDM process budget outside admission bounds");
+        FILETIME c,e,k,u;
+        if(!GetProcessTimes(GetCurrentProcess(),&c,&e,&k,&u))throw std::runtime_error("Cannot bind WDDM accounting to this process creation identity");
+        pid=GetCurrentProcessId();creation=ticks(c);
+        ComPtr<IDXGIFactory1> factory;
+        success(CreateDXGIFactory1(IID_PPV_ARGS(factory.GetAddressOf())),"CreateDXGIFactory1");
+        for(UINT i=0;i<32;++i){
+            ComPtr<IDXGIAdapter1> candidate;
+            const HRESULT found=factory->EnumAdapters1(i,candidate.GetAddressOf());
+            if(found==DXGI_ERROR_NOT_FOUND)break;
+            success(found,"EnumAdapters1");
+            DXGI_ADAPTER_DESC1 d={};success(candidate->GetDesc1(&d),"GetDesc1");
+            if(d.VendorId!=0x8086||(d.Flags&DXGI_ADAPTER_FLAG_SOFTWARE)||std::wstring(d.Description).find(L"B70")==std::wstring::npos)continue;
+            if(adapter)throw std::runtime_error("Multiple B70 DXGI adapters require separate qualification");
+            if(d.DedicatedVideoMemory<24ULL*1024*1024*1024)throw std::runtime_error("B70 dedicated-memory identity differs from the qualified machine");
+            success(candidate.As(&adapter),"IDXGIAdapter3 query");desc=d;
+        }
+        if(!adapter)throw std::runtime_error("WDDM B70 adapter missing; no accounting fallback");
+    }
+};
+memory_guard::memory_guard(uint64_t limit,uint64_t spare,uint64_t shared):state_(new impl(limit,spare,shared)){}
+memory_guard::~memory_guard()=default;
+void memory_guard::check(uint64_t planned){
+    auto & s=*state_;std::lock_guard<std::mutex> lock(s.mutex);
+    FILETIME c,e,k,u;
+    if(GetCurrentProcessId()!=s.pid||!GetProcessTimes(GetCurrentProcess(),&c,&e,&k,&u)||ticks(c)!=s.creation)
+        throw std::runtime_error("WDDM process identity mismatch");
+    success(s.adapter->QueryVideoMemoryInfo(0,DXGI_MEMORY_SEGMENT_GROUP_LOCAL,&s.local),"WDDM local memory query");
+    success(s.adapter->QueryVideoMemoryInfo(0,DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL,&s.nonlocal),"WDDM nonlocal memory query");
+    ++s.queries;s.peak_local=std::max(s.peak_local,s.local.CurrentUsage);s.peak_nonlocal=std::max(s.peak_nonlocal,s.nonlocal.CurrentUsage);
+    if(s.local.Budget<=s.headroom)throw std::runtime_error("WDDM did not provide a usable local-memory budget");
+    const uint64_t allowed=std::min(s.local_limit,s.local.Budget>s.headroom?s.local.Budget-s.headroom:0);
+    if(s.local.CurrentUsage>allowed||planned>allowed-s.local.CurrentUsage)
+        throw std::runtime_error("Owned B70 process exceeds VRAM limit or WDDM headroom; no resize/retry fallback");
+    if(s.nonlocal.CurrentUsage>s.nonlocal_limit)
+        throw std::runtime_error("Owned B70 process exceeds nonlocal GPU-memory limit");
+}
+std::string memory_guard::stats_json()const{
+    const auto & s=*state_;std::lock_guard<std::mutex> lock(s.mutex);
+    return "{\"source\":\"IDXGIAdapter3.QueryVideoMemoryInfo\",\"pid\":"+std::to_string(s.pid)+
+        ",\"creation_filetime\":"+std::to_string(s.creation)+",\"vendor_id\":"+std::to_string(s.desc.VendorId)+
+        ",\"device_id\":"+std::to_string(s.desc.DeviceId)+",\"subsystem_id\":"+std::to_string(s.desc.SubSysId)+
+        ",\"revision\":"+std::to_string(s.desc.Revision)+",\"dedicated_video_memory\":"+std::to_string(uint64_t(s.desc.DedicatedVideoMemory))+
+        ",\"adapter_luid_low\":"+std::to_string(s.desc.AdapterLuid.LowPart)+",\"adapter_luid_high\":"+std::to_string(uint32_t(s.desc.AdapterLuid.HighPart))+
+        ",\"local_current\":"+std::to_string(s.local.CurrentUsage)+",\"local_peak_observed\":"+std::to_string(s.peak_local)+
+        ",\"local_budget\":"+std::to_string(s.local.Budget)+",\"local_limit\":"+std::to_string(s.local_limit)+
+        ",\"headroom\":"+std::to_string(s.headroom)+",\"nonlocal_current\":"+std::to_string(s.nonlocal.CurrentUsage)+
+        ",\"nonlocal_peak_observed\":"+std::to_string(s.peak_nonlocal)+",\"nonlocal_limit\":"+std::to_string(s.nonlocal_limit)+
+        ",\"queries\":"+std::to_string(s.queries)+"}";
+}
+}}
