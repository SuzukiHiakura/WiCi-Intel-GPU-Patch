+        ggml_backend_buffer_set_usage(owner.host_buf,GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        auto * weights=ggml_new_tensor_3d(owner.gpu_ctx,GGML_TYPE_F32,columns,rows,experts);
+        auto * x=ggml_new_tensor_3d(owner.gpu_ctx,GGML_TYPE_F32,columns,1,1);
+        auto * ids=ggml_new_tensor_2d(owner.gpu_ctx,GGML_TYPE_I32,1,1);
+        auto * y=ggml_mul_mat_id(owner.gpu_ctx,weights,x,ids);
+        require(ggml_backend_dev_supports_op(device,y),"B70 MUL_MAT_ID unsupported; no CPU fallback");
+        auto * graph=ggml_new_graph_custom(owner.gpu_ctx,32,false);ggml_build_forward_expand(graph,y);
+        owner.gpu_buf=ggml_backend_alloc_ctx_tensors(owner.gpu_ctx,owner.backend);require(owner.gpu_buf!=nullptr,"bounded GPU test tensors failed");
+        require(ggml_backend_buffer_get_size(owner.gpu_buf)<256*mib,"GPU test workspace unexpectedly large");
+        ggml_backend_tensor_set(weights,sentinels.data(),0,ggml_nbytes(weights));
+        std::vector<float> vector(columns),result(rows);
+        for(int c=0;c<columns;++c)vector[c]=float(c%7-3)/32.0f;
+        ggml_backend_tensor_set(x,vector.data(),0,vector.size()*sizeof(float));
+        source input;input.fd=owner.fd;input.metadata=source_meta;
+        require(ssd::platform::identity(owner.fd,input.fixture),"fixture identity failed");
+        ssd::stream::buffer_cache cache({&input,source::resolve,nullptr},128*mib,64*mib);cache.bind_source(source::validate,&input);cache.attach(owner.backend);
+        std::vector<int> order={0,1,0};for(int e=2;e<10;++e)order.push_back(e);order.push_back(0);
+        for(int e=10;e<experts;++e)order.push_back(e);order.push_back(1);
+        float max_error=0;
+        for(int e:order){
+            int32_t counts[experts]={};counts[e]=1;
+            ggml_backend_synchronize(owner.backend);
+            ggml_backend_tensor_set(weights,sentinels.data(),size_t(e)*stride,stride);
+            require(cache.copy(owner.backend,source_meta,weights,experts,stride,counts)==1,"SSD/cache/GPU copy failed");
+            const int32_t id=e;ggml_backend_tensor_set(ids,&id,0,sizeof(id));
+            require(ggml_backend_graph_compute(owner.backend,graph)==GGML_STATUS_SUCCESS,"direct B70 expert graph failed");
+            ggml_backend_synchronize(owner.backend);ggml_backend_tensor_get(y,result.data(),0,result.size()*sizeof(float));
+            for(int r=0;r<rows;++r){
+                double expected=0;for(int c=0;c<columns;++c)expected+=double(weight(e,r,c))*vector[c];
+                require(std::isfinite(result[r]),"non-finite B70 result");
+                max_error=std::max(max_error,float(std::abs(double(result[r])-expected)));
+            }
+        }
+        const auto stats=cache.stats();
+        require(max_error<1e-5f,"B70 expert arithmetic differs from scalar reference");
+        require(stats.ssd_reads>0&&stats.gpu_hits>0&&stats.host_hits>0&&stats.host_evictions>0&&stats.gpu_evictions>0,"cache hit/eviction gates not exercised");
+        require(stats.host_peak<=128*mib&&stats.gpu_peak<=64*mib&&stats.gpu_reserved_peak<=64*mib&&stats.gpu_allocation_peak<=64*mib,"cache budget exceeded");
+        require(stats.device_local_checks>0&&stats.gpu_allocation_bytes>0,"No actual B70 device-local allocation evidence");
+        require(cache.observe_memory(),"process VRAM accounting/ceiling failed");
+        std::printf("{\"format\":\"wicibridge-cache-transport-test/1\",\"passed\":true,\"model_inference\":false,\"bridge_complete\":false,\"cpu_math_fallback\":false,\"calls\":%zu,\"max_abs_error\":%.9g,\"cache\":%s}\n",order.size(),max_error,cache.stats_json().c_str());
+        return 0;
+    }catch(const std::exception & e){std::fprintf(stderr,"cache transport test failed: %.512s\n",e.what());return 1;}
+}
