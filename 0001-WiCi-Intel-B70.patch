+        }
+        ++count.host_misses;
+        const uint64_t begin=offset&~uint64_t(alignment-1);
+        const size_t lead=size_t(offset-begin),physical=aligned_size(lead+bytes);
+        require(physical<=max_read && physical<=host_budget,"one expert exceeds read/cache budget");
+        require(offset<=id.size && bytes<=id.size-offset,"expert range exceeds immutable file");
+        while(count.host_live+physical>host_budget || host.size()>=max_entries)evict_host();
+        auto e=std::make_unique<host_entry>();e->allocated=physical;e->lead=lead;
+        e->arena=platform::arena_reserve(physical);
+        require(e->arena&&platform::arena_commit(e->arena,physical),"bounded expert arena allocation failed");
+        const uint64_t ticket=++tag;
+        read_custody borrowed{ring}; // unwinds before e; a pending read cannot outlive its buffer
+        require(!stopping(),"stop requested before SSD read");
+        require(bool(ring.queue({fd,begin,physical},e->arena,ticket,false)),"expert read queue failed");
+        require(bool(ring.submit(1)),"expert read submit failed");
+        const auto deadline=clock::now()+std::chrono::seconds(5);
+        auto cancel_deadline=deadline+std::chrono::seconds(2);
+        bool cancelled=false,received=false;
+        io::completion completion={};
+        while(!received){
+            const auto r=ring.pop(completion);require(bool(r),"expert read completion failed");
+            if(r.value){received=true;break;}
+            if(!cancelled&&(clock::now()>=deadline||stopping())){
+                const HANDLE file=static_cast<HANDLE>(platform::native_handle(fd));
+                const BOOL ok=CancelIoEx(file,nullptr);
+                require(ok||GetLastError()==ERROR_NOT_FOUND,"cancel exact owned source handle failed");
+                cancelled=true;++count.cancellations;
+                cancel_deadline=clock::now()+std::chrono::seconds(2);
+            }
+            // An undrained kernel buffer must never be released or reused.
+            // Abort is a failed run; the owner retains evidence and cannot retry.
+            if(cancelled&&clock::now()>=cancel_deadline){
+                std::fputs("[b70.cache] cancellation did not drain; aborting owned run\n",stderr);std::abort();
+            }
+            Sleep(1);
+        }
+        require(ring.pending()==0&&completion.user_data==ticket,"expert read completion identity mismatch");
+        ++count.ssd_reads;
+        if(completion.res>0)count.ssd_bytes+=uint64_t(completion.res);
+        require(!cancelled&&completion.res>=0&&size_t(completion.res)>=lead+bytes,"expert read short/error/cancelled");
+        require(version(fd)==id,"expert file version changed during read");
+        host_lru.push_front(k);e->lru=host_lru.begin();
+        count.host_live+=physical;count.host_peak=std::max(count.host_peak,count.host_live);
+        auto & result=*e;host.emplace(k,std::move(e));return result;
+    }
+    gpu_entry & resident(const key & k,int fd,uint64_t offset,size_t bytes,const platform::file_identity & id){
+        const auto hit=gpu.find(k);
+        if(hit!=gpu.end()){
+            ++count.gpu_hits;gpu_lru.splice(gpu_lru.begin(),gpu_lru,hit->second->lru);return *hit->second;
+        }
+        ++count.gpu_misses;
+        const size_t align=ggml_backend_get_alignment(backend);
+        require(align && bytes<=SIZE_MAX-align,"GPU cache size overflow");
+        const size_t needed=(bytes+align-1)/align*align;
+        require(needed<=gpu_budget,"one expert exceeds GPU cache budget");
+        while(count.gpu_live+needed>gpu_budget || gpu.size()>=max_entries)evict_gpu();
+        host_entry & cpu=read(k,fd,offset,bytes,id);
+        const auto location=slot(needed);
+        auto e=std::make_unique<gpu_entry>();
+        e->raw=ggml_new_tensor_1d(e->meta.value,GGML_TYPE_I8,int64_t(bytes));
+        e->allocated=needed;e->chunk=location.first;e->offset=location.second;
+        auto buffer=chunks[e->chunk]->buffer;
+        require(ggml_backend_tensor_alloc(buffer,e->raw,static_cast<char *>(ggml_backend_buffer_get_base(buffer))+e->offset)==GGML_STATUS_SUCCESS,"GPU raw expert placement failed");
+        ggml_backend_tensor_set(e->raw,static_cast<const char *>(cpu.arena)+cpu.lead,0,bytes);
+        ggml_backend_synchronize(backend);memory->check();count.h2d_bytes+=bytes;
+        gpu_lru.push_front(k);e->lru=gpu_lru.begin();
+        count.gpu_live+=e->allocated;count.gpu_peak=std::max(count.gpu_peak,count.gpu_live);
+        auto & result=*e;gpu.emplace(k,std::move(e));return result;
+    }
+};
+
+buffer_cache::buffer_cache(store::source_view s,uint64_t host,uint64_t gpu,uint64_t limit,uint64_t spare,uint64_t shared):state_(new impl(s,host,gpu,limit,spare,shared)){}
+buffer_cache::~buffer_cache()=default;
+void buffer_cache::set_stop(bool(*f)(void *),void * data)noexcept{state_->stop=f;state_->stop_data=data;}
+void buffer_cache::bind_source(source_validator validator,void * userdata){
+    auto & s=*state_;std::lock_guard<std::mutex> lock(s.mutex);
+    require(!s.failed&&!s.validator&&validator&&userdata,"One exact immutable source validator is required");
+    s.validator=validator;s.validator_data=userdata;
+}
+bool buffer_cache::prepare_graph(ggml_backend_sched_t scheduler,ggml_cgraph * graph)noexcept{
+    auto & s=*state_;std::lock_guard<std::mutex> lock(s.mutex);
+    try{
+        require(!s.failed&&s.backend&&s.validator&&scheduler&&graph,"B70 graph requires its attached source/backend");
+        require(!s.stopping(),"owned stop requested before graph allocation");
+        require(s.memory!=nullptr,"WDDM process accounting missing");s.memory->check();
+        // Metadata-only rejection inventory. No allocation, source read, compute or
+        // admission decision is changed. The original refusal loop follows intact.
+        unsigned rejected = 0, signatures_logged = 0, unrecorded_occurrences = 0;
+        std::set<std::string> signatures;
+        auto tensor_signature = [](const ggml_tensor * t) {
+            if (!t) return std::string("null");
+            std::string out = std::string(ggml_op_name(t->op))+":"+ggml_type_name(t->type)+":"+std::to_string(ggml_nbytes(t));
+            for (int d=0;d<4;++d) out += ":"+std::to_string(t->ne[d])+"/"+std::to_string(t->nb[d]);
+            for (auto parameter:t->op_params) out += ":"+std::to_string(parameter);
+            return out;
+        };
+        auto describe = [](const char * role,int index,const ggml_tensor * t) {
+            if (!t) return;
+            std::fprintf(stderr,"[b70.reject] %s=%d name=%.96s op=%s type=%s bytes=%zu ne=[%lld,%lld,%lld,%lld] nb=[%zu,%zu,%zu,%zu] buffer=%.96s view=%.96s params=",
+                role,index,t->name,ggml_op_name(t->op),ggml_type_name(t->type),ggml_nbytes(t),
+                (long long)t->ne[0],(long long)t->ne[1],(long long)t->ne[2],(long long)t->ne[3],
+                t->nb[0],t->nb[1],t->nb[2],t->nb[3],t->buffer?ggml_backend_buffer_name(t->buffer):"unallocated",t->view_src?t->view_src->name:"none");
+            for (auto parameter:t->op_params) std::fprintf(stderr,"%08x,",unsigned(parameter));
+            std::fputc('\n',stderr);
+        };
+        for (int i=0;i<ggml_graph_n_nodes(graph);++i) {
+            auto * n=ggml_graph_node(graph,i);
+            switch(n->op) {
+                case GGML_OP_NONE:case GGML_OP_VIEW:case GGML_OP_RESHAPE:
+                case GGML_OP_PERMUTE:case GGML_OP_TRANSPOSE:continue;
+                default:break;
+            }
+            if ((i&63)==0) require(!s.stopping(),"Owned stop requested during graph rejection inventory");
+            if (ggml_backend_dev_supports_op(s.device,n)) continue;
+            ++rejected;
+            auto signature=tensor_signature(n);
+            for (int j=0;j<GGML_MAX_SRC;++j) signature += "|"+tensor_signature(n->src[j]);
+            if (signatures.count(signature)) continue;
+            if (signatures.size()>=128) { ++unrecorded_occurrences;continue; }
+            signatures.insert(std::move(signature));++signatures_logged;
+            describe("node",i,n);
+            for (int j=0;j<GGML_MAX_SRC;++j) if(n->src[j]) describe("src",j,n->src[j]);
+        }
+        if(rejected) {
+            std::fprintf(stderr,"[b70.reject] rejected_occurrences=%u signatures_logged=%u unrecorded_occurrences=%u signature_inventory_complete=%s\n",
+                rejected,signatures_logged,unrecorded_occurrences,unrecorded_occurrences?"false":"true");
+            std::fflush(stderr);
+        }
+        std::set<const ggml_tensor *> admitted,used;
+        auto host_weight=[&](const ggml_tensor * tensor)->bool{
+            if(!tensor)return false;
+            const auto * root=tensor;
+            size_t views=0;
+            while(root->view_src){require(++views<=16,"Expert view chain exceeds its bound");root=root->view_src;}
+            const auto buffer=tensor->buffer?tensor->buffer:root->buffer;
+            if(!buffer||ggml_backend_buffer_get_usage(buffer)!=GGML_BACKEND_BUFFER_USAGE_WEIGHTS||!ggml_backend_buffer_is_host(buffer))return false;
+            require(root==tensor,"Deferred-weight aliases/views cannot bypass native source binding");
+            require(tensor->ne[2]>=2&&tensor->ne[2]<=65536&&tensor->ne[3]==1&&ggml_is_contiguous(tensor),"Host weight is not an admitted expert plane");
+            const size_t stride=tensor->nb[2];const int64_t experts=tensor->ne[2];
+            require(stride&&uint64_t(experts)<=SIZE_MAX/stride&&size_t(experts)*stride==ggml_nbytes(tensor),"Native expert geometry overflows");
+            if(admitted.insert(tensor).second){
+                int first_fd=-1,last_fd=-1;uint64_t first_offset=0,last_offset=0;size_t first_bytes=0,last_bytes=0;
+                require(s.source.resolve(s.source.userdata,tensor->name,0,stride,experts,&first_fd,&first_offset,&first_bytes)&&
+                    s.source.resolve(s.source.userdata,tensor->name,int(experts-1),stride,experts,&last_fd,&last_offset,&last_bytes)&&
+                    first_fd==last_fd&&first_bytes==stride&&last_bytes==stride&&
+                    first_offset<=UINT64_MAX-uint64_t(experts-1)*stride&&last_offset==first_offset+uint64_t(experts-1)*stride&&
+                    s.validator(s.validator_data,tensor,first_fd,first_offset,stride,experts,0)&&
+                    s.validator(s.validator_data,tensor,last_fd,last_offset,stride,experts,int(experts-1)),
+                    "Expert source endpoints do not match the actual loaded model catalog");
+            }
+            return true;
+        };
+        int routed=0;
+        for(int i=0;i<ggml_graph_n_nodes(graph);++i){
+            auto * node=ggml_graph_node(graph,i);
+            for(int j=0;j<GGML_MAX_SRC;++j){
+                const auto * source=node->src[j];
+                if(host_weight(source)){
+                    require(node->op==GGML_OP_MUL_MAT_ID&&j==0,"Every deferred-weight use must enter the exact expert-copy hook");
+                    used.insert(source);
+                }
+            }
+            if(node->op==GGML_OP_MUL_MAT_ID){require(host_weight(node->src[0]),"Every routed matrix must use its native deferred expert plane");}
+            switch(node->op){
+                case GGML_OP_NONE:case GGML_OP_VIEW:case GGML_OP_RESHAPE:
+                case GGML_OP_PERMUTE:case GGML_OP_TRANSPOSE:continue;
+                default:break;
+            }
+            require(ggml_backend_dev_supports_op(s.device,node),"B70 lacks a required graph operator before allocation");
+            ggml_backend_sched_set_tensor_backend(scheduler,node,s.backend);
+            if(node->op==GGML_OP_MUL_MAT_ID)++routed;
+        }
+        for(int i=0;i<graph->n_leafs;++i){
+            const auto * leaf=graph->leafs[i];
+            if(host_weight(leaf)){require(used.count(leaf)>0,"Deferred expert leaf has no admitted direct routed use");}
+        }
+        require(routed>0&&used==admitted,"SSD graph has missing or untracked deferred expert uses");
+        return true;
+    }catch(const std::exception & e){s.failed=true;std::fprintf(stderr,"[b70.cache] graph placement failed: %.512s\n",e.what());return false;}
+}
+bool buffer_cache::validate_graph(ggml_backend_sched_t scheduler,ggml_cgraph * graph)noexcept{
+    auto & s=*state_;std::lock_guard<std::mutex> lock(s.mutex);
+    try{
+        require(!s.failed&&s.backend&&scheduler&&graph,"B70 graph requires a healthy attached cache");
+        require(!s.stopping(),"owned stop requested before graph execution");
+        require(s.memory!=nullptr,"WDDM process accounting missing");s.memory->check();
+        int routed=0;
+        for(int i=0;i<ggml_graph_n_nodes(graph);++i){
+            auto * node=ggml_graph_node(graph,i);
+            // These operators only describe the same storage; no arithmetic
+            // runs on a CPU by allowing their metadata to be hosted there.
+            switch(node->op){
+                case GGML_OP_NONE:case GGML_OP_VIEW:case GGML_OP_RESHAPE:
+                case GGML_OP_PERMUTE:case GGML_OP_TRANSPOSE:continue;
+                default:break;
+            }
+            auto * selected=ggml_backend_sched_get_tensor_backend(scheduler,node);
+            require(selected==s.backend,"compute selected another backend; no CPU/AMD/CUDA fallback");
+            require(ggml_backend_dev_supports_op(s.device,node),"B70 lacks a required graph operator");
+            if(node->op==GGML_OP_MUL_MAT_ID)++routed;
+        }
+        require(routed>0,"SSD graph contains no routed expert computation");
+        return true;
+    }catch(const std::exception & e){s.failed=true;std::fprintf(stderr,"[b70.cache] graph admission failed: %.512s\n",e.what());return false;}
+}
+void buffer_cache::attach(ggml_backend_t backend){
+    auto & s=*state_;std::lock_guard<std::mutex> lock(s.mutex);
+    require(backend!=nullptr&&!s.backend,"B70 cache backend attached twice or missing");
+    const auto device=ggml_backend_get_device(backend);
+    const auto registry=ggml_backend_dev_backend_reg(device);
+    const char * type=ggml_backend_reg_name(registry),*desc=ggml_backend_dev_description(device);
+    require(type&&std::strcmp(type,"Vulkan")==0&&desc&&std::strstr(desc,"Intel")&&std::strstr(desc,"B70")&&
+            ggml_backend_dev_type(device)==GGML_BACKEND_DEVICE_TYPE_GPU,"B70 discrete Vulkan backend required; no fallback");
+    size_t free=0,total=0;ggml_backend_dev_memory(device,&free,&total);
+    require(total>=24*1024*mib && free>=s.gpu_budget+1024*mib,"B70 memory reserve insufficient");
+    require(!std::getenv("GGML_VK_PREFER_HOST_MEMORY")&&!std::getenv("GGML_VK_ALLOW_SYSMEM_FALLBACK"),"B70 rejects inherited host/fallback flags by name");
+    s.memory_query=reinterpret_cast<ggml_backend_vk_buffer_memory_query_v1>(ggml_backend_reg_get_proc_address(registry,"ggml_backend_vk_buffer_memory_query_v1"));
+    require(s.memory_query!=nullptr,"Same-build B70 memory inspection interface required");
+    s.bounded_alloc=reinterpret_cast<ggml_backend_vk_alloc_bounded_v1>(ggml_backend_reg_get_proc_address(registry,"ggml_backend_vk_alloc_bounded_v1"));
+    require(s.bounded_alloc!=nullptr,"Same-build B70 preallocation physical-budget interface required");
+    s.backend=backend;s.device=device;
+    s.memory=std::make_unique<memory_guard>(s.process_limit,s.headroom,s.nonlocal_limit);s.memory->check();
+}
+bool buffer_cache::observe_memory()noexcept{
+    auto & s=*state_;std::lock_guard<std::mutex> lock(s.mutex);
+    try{require(!s.failed&&s.memory,"healthy WDDM accounting required");s.memory->check();return true;}
+    catch(const std::exception & e){s.failed=true;std::fprintf(stderr,"[b70.cache] memory admission failed: %.512s\n",e.what());return false;}
+}
+void buffer_cache::invalidate()noexcept{
+    std::lock_guard<std::mutex> lock(state_->mutex);state_->failed=true;
+}
+int buffer_cache::copy(ggml_backend_t backend,const ggml_tensor * input,ggml_tensor * output,int64_t experts,size_t stride,const int32_t * counts)noexcept{
+    auto & s=*state_;std::lock_guard<std::mutex> lock(s.mutex);
+    try{
+        require(!s.failed&&s.validator,"expert cache requires healthy native source binding; no retry");
+        require(s.backend&&backend==s.backend&&ggml_backend_get_device(backend)==s.device,"SSD copy addressed a different backend");
+        require(input&&output&&counts&&experts>0&&experts<=65536&&stride>0,"invalid expert copy geometry");
+        require(input->type==output->type&&ggml_are_same_shape(input,output),"expert source and destination types/shapes differ");
+        require(input->ne[2]==experts&&input->nb[2]==stride&&ggml_nbytes(input)==ggml_nbytes(output),"expert tensor stride/shape mismatch");
+        require(input->ne[3]==1&&output->ne[3]==1&&ggml_is_contiguous(input)&&ggml_is_contiguous(output),"expert byte transport requires one contiguous expert plane");
+        require(uint64_t(experts)<=SIZE_MAX/stride&&size_t(experts)*stride==ggml_nbytes(input),"expert plane does not cover the exact tensor bytes");
+        require(ggml_backend_buffer_is_host(input->buffer),"expert source must retain metadata on its host buffer");
+        require(!ggml_backend_buffer_is_host(output->buffer),"expert destination must be a B70 device buffer");
+        require(ggml_backend_buft_get_device(ggml_backend_buffer_get_type(output->buffer))==s.device,"expert destination is on a different GPU");
+        ggml_backend_synchronize(backend);
+        ggml_backend_vk_buffer_memory_info_v1 destination_info{};destination_info.version=1;destination_info.size=sizeof(destination_info);
+        require(s.memory_query&&s.memory_query(output->buffer,&destination_info)&&destination_info.strict_device_memory&&
+                destination_info.device_local&&!destination_info.imported_host,"Expert destination lacks actual strict device-local memory");
+        ++s.count.device_local_checks;s.count.last_destination_allocation_bytes=destination_info.allocation_bytes;
+        for(int64_t expert=0;expert<experts;++expert){
+            require(counts[expert]>=0,"invalid negative expert count");
+            if(counts[expert]==0)continue;
+            require(!s.stopping(),"stop requested before GPU expert copy");
+            int fd=-1;uint64_t offset=0;size_t logical=0;
+            require(s.source.resolve(s.source.userdata,input->name,int(expert),stride,experts,&fd,&offset,&logical)&&logical==stride,"missing exact expert source range");
+            require(s.validator(s.validator_data,input,fd,offset,stride,experts,int(expert)),"Expert alias does not match the actual loaded source catalog");
+            const auto id=s.version(fd);
+            require(offset<=id.size&&stride<=id.size-offset,"logical expert range exceeds the immutable file");
+            const size_t padding=expert+1<experts?std::min<size_t>(stride,512):0;
+            if(padding){
+                int next_fd=-1;uint64_t next_offset=0;size_t next_bytes=0;
+                require(s.source.resolve(s.source.userdata,input->name,int(expert+1),stride,experts,&next_fd,&next_offset,&next_bytes)&&
+                    next_fd==fd&&next_offset==offset+stride&&next_bytes==stride&&
+                    s.validator(s.validator_data,input,next_fd,next_offset,stride,experts,int(expert+1)),"padding requires contiguous catalog-bound GGUF experts");
+            }
+            const size_t bytes=stride+padding;
+            require(uint64_t(expert)<=SIZE_MAX/stride,"expert destination offset overflow");
+            const size_t to=size_t(expert)*stride;
+            require(to<=ggml_nbytes(output)&&bytes<=ggml_nbytes(output)-to,"expert destination range overflow");
+            auto & resident=s.resident(make_key(id,offset,bytes),fd,offset,bytes,id);
+            meta_owner meta;
+            auto * destination=ggml_new_tensor_1d(meta.value,GGML_TYPE_I8,int64_t(bytes));
+            require(ggml_backend_tensor_alloc(output->buffer,destination,static_cast<char *>(output->data)+to)==GGML_STATUS_SUCCESS,"B70 destination byte view placement failed");
+            require(ggml_backend_buffer_copy_tensor(resident.raw,destination),"B70 device-to-device copy unavailable; no host staging fallback");
+            ggml_backend_synchronize(backend);s.memory->check();s.count.d2d_bytes+=bytes;++s.count.slices;
+        }
+        return 1;
+    }catch(const std::exception & error){s.failed=true;std::fprintf(stderr,"[b70.cache] failure, no fallback: %.512s\n",error.what());return -1;}
+}
+buffer_cache::counters buffer_cache::stats()const{std::lock_guard<std::mutex> lock(state_->mutex);return state_->count;}
+std::string buffer_cache::stats_json()const{
+    const auto c=stats();std::string out="{";
+#define FIELD(name) out+="\"" #name "\":"+std::to_string(c.name)+",";
+    FIELD(ssd_reads) FIELD(ssd_bytes) FIELD(host_hits) FIELD(host_misses) FIELD(host_evictions)
+    FIELD(gpu_hits) FIELD(gpu_misses) FIELD(gpu_evictions) FIELD(h2d_bytes) FIELD(d2d_bytes) FIELD(slices)
+    FIELD(host_live) FIELD(host_peak) FIELD(gpu_live) FIELD(gpu_peak) FIELD(gpu_reserved) FIELD(gpu_reserved_peak) FIELD(cancellations)
+    FIELD(gpu_allocation_bytes) FIELD(gpu_allocation_peak) FIELD(device_local_checks) FIELD(last_destination_allocation_bytes)
+#undef FIELD
+    out+="\"host_budget\":"+std::to_string(state_->host_budget)+",\"gpu_budget\":"+std::to_string(state_->gpu_budget)+",\"fallbacks\":0,\"process_memory\":"+(state_->memory?state_->memory->stats_json():"null")+"}";
+    return out;
+}
+}}
